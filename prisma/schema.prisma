generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}



model User {
  id                String    @id // Supabase Auth user id
  email             String    @unique
  name              String?
  plan_type         String    @default("free")
  credits           Int       @default(10)
  subscription_tier String    @default("FREE")
  created_at        DateTime  @default(now())

  projects         Project[]
  api_key          ApiKey?
  articles         Article[]
  profile          Profile?
  payment_history  PaymentHistory[]

  @@map("users")
}

model Profile {
  id               String   @id @default(uuid())
  user_id          String   @unique
  store_name       String?
  industry         String?
  address          String?
  phone            String?
  reservation_link String?
  brand_color      String?
  tone             String?
  about_us         String?  @db.Text
  created_at       DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Project {
  id           String    @id @default(uuid())
  user_id      String
  project_name String
  created_at   DateTime  @default(now())

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  articles Article[]

  @@map("projects")
}

model Article {
  id               String    @id @default(uuid())
  user_id          String
  project_id       String
  title            String
  target_keyword   String
  content_markdown String?   @db.Text
  content_html     String?   @db.Text
  status           String    @default("DRAFT")
  job_id           String?
  generator_draft  String?   @db.Text
  error_message    String?   @db.Text
  citations        String?   @db.Text
  created_at       DateTime  @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("articles")
}


model ApiKey {
  id                 String   @id @default(uuid())
  user_id            String   @unique
  
  // WordPress
  wp_url               String?
  wp_username          String?
  wp_api_key           String?
  
  // Tistory
  tistory_access_token String?
  tistory_blog_name    String?

  created_at           DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model PaymentHistory {
  id           String   @id @default(uuid())
  user_id      String
  order_id     String   @unique
  payment_key  String?
  amount       Int
  status       String   @default("PENDING") // PENDING, DONE, CANCELED, ABORTED
  plan_type    String
  receipt_url  String?
  created_at   DateTime @default(now())
  completed_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("payment_history")
}

model CardImage {
  id         String   @id // e.g. "card_xxxx"
  data       Bytes    @db.ByteA
  mime_type  String   @default("image/png")
  created_at DateTime @default(now())

  @@map("card_images")
}

