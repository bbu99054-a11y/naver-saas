generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}



model User {
  id                String    @id // Supabase Auth user id
  email             String    @unique
  name              String?
  plan_type         String    @default("free")
  credits           Int       @default(3)
  subscription_tier String    @default("FREE")
  locked_until      DateTime?
  created_at        DateTime  @default(now())

  projects         Project[]
  api_key          ApiKey?
  articles         Article[]
  profile          Profile?
  payment_history  PaymentHistory[]

  @@map("users")
}

model Profile {
  id               String   @id @default(uuid())
  user_id          String   @unique
  store_name       String?
  industry         String?
  address          String?
  phone            String?
  reservation_link String?
  brand_color      String?
  tone             String?
  about_us         String?  @db.Text
  created_at       DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Project {
  id           String    @id @default(uuid())
  user_id      String
  project_name String
  created_at   DateTime  @default(now())

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  articles Article[]

  @@map("projects")
}

model Article {
  id               String    @id @default(uuid())
  user_id          String
  project_id       String
  title            String
  target_keyword   String
  content_markdown String?   @db.Text
  content_html     String?   @db.Text
  status           String    @default("DRAFT")
  job_id           String?
  generator_draft  String?   @db.Text
  error_message    String?   @db.Text
  citations        String?   @db.Text
  created_at       DateTime  @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("articles")
}


model ApiKey {
  id                 String   @id @default(uuid())
  user_id            String   @unique
  
  // WordPress
  wp_url               String?
  wp_username          String?
  wp_api_key           String?
  
  // Tistory
  tistory_access_token String?
  tistory_blog_name    String?

  created_at           DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model PaymentHistory {
  id                 String    @id @default(uuid())
  user_id            String
  order_id           String    @unique
  payment_key        String?
  amount             Int
  status             String    @default("PENDING") // PENDING, DONE, CANCELED, ABORTED
  plan_type          String
  receipt_url        String?
  depositor_name     String?
  depositor_phone    String?
  tax_deduction_type String?   // NONE, PERSONAL, BUSINESS
  tax_deduction_num  String?
  created_at         DateTime  @default(now())
  completed_at       DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("payment_history")
}

model CardImage {
  id         String   @id // e.g. "card_xxxx"
  data       Bytes    @db.ByteA
  mime_type  String   @default("image/png")
  created_at DateTime @default(now())

  @@map("card_images")
}

model cross_posts_log {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform          String
  target_keyword    String
  post_title        String
  image_url         String?
  external_post_url String?
  status            String?   @default("SUCCESS")
  error_message     String?
  published_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@index([platform], map: "idx_cross_posts_platform")
}

model marketing_leads {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String    @unique
  name                   String?
  industry               String?
  store_name             String?
  region                 String?
  blog_url               String?
  source                 String?   @default("outbound_scrape")
  status                 String?   @default("PENDING")
  prohibited_words_found String[]
  last_sent_at           DateTime? @db.Timestamptz(6)
  lead_magnet_sent       Boolean?  @default(false)
  created_at             DateTime? @default(now()) @db.Timestamptz(6)
  audit_post_title       String?
  audit_score            Int?
  audit_issues_count     Int?
  audit_prohibited_words String[]

  @@index([email], map: "idx_marketing_leads_email")
  @@index([status], map: "idx_marketing_leads_status")
}

model Lead {
  id           String   @id @default(cuid())
  toolSource   String   // 'place', 'adcheck', 'crop', 'byte', 'hwpx', 'utm', 'convert', 'landing' 등
  leadType     String   // 'audit_report', 'ebook', 'saas_trial', 'contact' 등
  email        String?
  phone        String?
  businessName String?  // 상호명 또는 병원/법률사무소 이름
  location     String?  // 지역/상권
  industry     String?  // 업종 (변호사, 세무사, 병원, 학원 등)
  metadata     Json?    // 검색 키워드, 진단 결과 등 부가 데이터
  status       String   @default("NEW") // NEW, CONTACTED, CONVERTED, CLOSED
  createdAt    DateTime @default(now())

  @@map("leads")
}



