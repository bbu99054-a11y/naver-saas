{
  "manifest_version": 3,
  "name": "SEO Affiliate Auto Publisher",
  "version": "1.0",
  "description": "네이버 블로그 자동 발행 확장 프로그램",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://blog.naver.com/*", "http://localhost:3000/*", "https://*.vercel.app/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.naver.com/*"
  ]
}
