@echo off
chcp 65001 > nul
title [PostSync] 출근/작업시작 - 최신 코드 가져오기 (Git Pull)

echo =======================================================
echo   🚀 [PostSync] 깃허브에서 최신 변경사항을 내려받습니다
echo =======================================================
echo.

cd /d %~dp0

echo [1/2] 로컬 상태 확인 중...
git status -s

echo.
echo [2/2] 깃허브 origin/main 에서 최신 코드 동기화 중...
git pull origin main

if %ERRORLEVEL% equ 0 (
    echo.
    echo =======================================================
    echo   ✅ 최신 코드 동기화 완료! 즐거운 작업 되세요.
    echo =======================================================
) else (
    echo.
    echo =======================================================
    echo   ❌ 동기화 중 오류가 발생했습니다.
    echo      로컬에 저장되지 않은 변경사항이 있는지 확인하세요.
    echo =======================================================
)

echo.
pause